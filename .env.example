NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=yourplatform.com
NEXT_PUBLIC_PLATFORM_URL=https://yourplatform.com

# Use only this app's dedicated Supabase project. Do not reuse another product's credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-new-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-new-project-anon-key
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
DOMAIN_CNAME_TARGET=yourplatform.com

# Phase 7 controlled AI assistance. Keep secrets server-side; never prefix AI_API_KEY with NEXT_PUBLIC_.
AI_PROVIDER=mock
AI_MODEL=mock-controlled-content-v1
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_DEFAULT_REQUEST_LIMIT=50
AI_DEFAULT_TOKEN_LIMIT=100000
